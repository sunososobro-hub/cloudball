      { "when": { "inning": { "min": 7 }, "margin": { "min": 1, "max": 2 } }, "gag": "bet", "needs": ["bet"], "once": true, "call": "{inning}局{half}結束，{leadTeam}領先{n:margin}分。", "response": "差這一點點，鹹酥雞誰請還很難講。" },
