      { "call": "教練走出來了，{team}要換人。", "response": "換個節奏，看能不能壓得住。", "alt": ["換個人，換個氣氛，也許局面就不一樣。", "新投手要快點進入狀況，不能讓對手喘氣。", "教練希望換人以後，場上的節奏換個樣子。"] },
      { "call": "{team}換投，教練跟主審比了手勢。", "response": "這一換，他心裡應該早有劇本了。", "alt": ["這個調度，看得出來是想好才走出來的。", "教練心裡早有安排，這一換有他的想法。", "換人這件事，教練應該已經想了一陣子。"] },
      { "call": "投手教練先上去講了幾句，總教練還是決定換人。", "response": "給了機會，球數到了就是到了。", "alt": ["球數到了，該休息了，沒什麼好說的。", "先發投手已經盡力了，接下來交給後面的人。", "投到這裡剛剛好，不要硬撐。"] }
