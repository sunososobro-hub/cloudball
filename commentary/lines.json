{
  "version": 2,
  "note": "Fallback line bank. Used when a game has no script of its own. Each exchange is a call (play-by-play voice) and an optional response (colour voice). Version 2 (#603): name-free; every spoken part is a clip, voiced slots come from closed sets, names and the play text stay on screen. Slots in {braces} are filled from the game so far. `guests` and `fan` are the third seat: the home team's fan, his moments keyed by trigger and by whether the home team just gained (up) or lost (down). See SCRIPT_FORMAT.md, and the point-of-view rules in README.md.",
  "rules": { "minGapSec": 7, "noRepeatWindow": 14, "colorChance": 0.45, "fanChance": 0.8, "fanGapSec": 5, "fanNoRepeatWindow": 10, "fanOwnShare": 0.3, "fanMaxUses": 2 },
  "triggers": {
    "game_start": { "priority": 2, "silence": 0, "delay": 1, "fanChance": 1, "exchanges": [
      { "call": "各位球迷晚安，今晚是{team}對上{fieldTeam}的熱身賽。", "response": "大家晚安，我是周國棟。這兩隊，我今天很期待。" },
      { "gag": "bet", "sets": ["bet"], "call": "歡迎收看雲端職棒，今晚{team}作客{fieldTeam}。", "response": "明凱，老規矩喔，比分猜錯的請鹹酥雞。" },
      { "call": "球員都就位了，{team}先攻，比賽準備開始。", "response": "先看第一局，投手今天的狀況一下就看得出來。" }
    ] },
    "batter_up": { "priority": 0, "silence": 0.4, "delay": 0.1, "exchanges": [
      { "call": "下一位打者站上打擊區。" },
      { "call": "接下來是{team}的打者。" },
      { "when": { "batterHits": { "min": 2 } }, "call": "這位打者今天已經{n:batterHits}支安打。", "response": "他今天手感很燙，投手要小心喔。", "alt": ["今天他看球很清楚，投手不能太好猜。", "手感這麼燙，投手跟他正面對決不划算。"] },
      { "when": { "batterKToday": { "min": 2 } }, "call": "這位打者今天已經被三振{n:batterKToday}次。", "response": "再被三振，我就叫他回去看錄影帶。", "alt": ["這打席先求碰到球再說。", "今天一直被三振，揮棒要縮短一點了。"] },
      { "when": { "hasPrev": 1 }, "call": "這位打者今天不是第一次站上打擊區了。", "response": "看他這次怎麼調整。", "alt": ["再碰一次，打者心裡比較有底了。", "剛剛投手怎麼配他的，他應該記得。", "看他這次有沒有準備。", "上一次的結果他心裡有數，這次會有調整。", "眼睛已經習慣今天的球速了。", "打過一輪的打者，比第一次站上去自在多了。", "這種時候投手不能照上一次的老路投。", "打者看過幾顆球了，這次不會那麼好騙。", "第二次碰到，雙方都知道對方有什麼。", "投手這次得換個配球，不然人家等著呢。", "看他有沒有學到上一次的教訓。", "上一次的經驗，這次就要用上了。", "他上一次怎麼被處理的，心裡應該有底。"] },
      { "when": { "hadLastInning": 1, "lastInningRuns": { "min": 2 } }, "call": "{team}上一局才拿下{n:lastInningRuns}分，這位打者接著上。", "response": "打線熱起來了，投手要穩住。", "alt": ["上一局打得順，氣勢還在。", "打線連起來了，投手不能讓他們再接下去。"] },
      { "when": { "hadLastInning": 1, "lastInningRuns": 0, "inning": { "min": 4 } }, "call": "打者上來，{team}上一局沒有得分。", "response": "上一局掛零，這局總要有點東西了吧。", "alt": ["上一局空手回去，這局要想辦法上壘。", "這局打線該醒一醒了。", "上一局沒動靜，這局看能不能弄點東西出來。", "上一局沒分，這局先讓人上壘再說。", "沒得分的時候，最怕急著想一棒解決。", "打線不要急，一個一個把壘包佔起來。", "掛零的時候，打者的肩膀都會縮緊。", "這種時候，保送也是好朋友。", "先上壘，後面的事比較好談。", "這局換個方法，不要老是追高球。", "上一局沒有動靜，教練席應該有話要講了。", "打線需要一個人先站上壘包。"] },
      { "when": { "pitchCount": { "min": 85 } }, "call": "打者上來，投手的用球數已經很高了。", "response": "到這個球數，手臂會開始重，我蹲過我知道。", "alt": ["球數到這裡，球速會開始掉。", "這個球數，投手的控球最容易跑掉。"] },
      { "gag": "story", "needs": ["story"], "once": true, "when": { "inning": { "min": 5 } }, "call": "下一位打者上來。周哥，你今晚講幾次「我當年」了？", "response": "沒幾次啦，是我當年的事比較多而已。" },
      { "when": { "batterPa": { "eq": 0 } }, "call": "{inning}局{half}，{outs}出局，{team}的打者，今天第一個打席。" },
      { "when": { "batterAb": { "min": 1 }, "batterHits": { "eq": 0 } }, "call": "這位打者今天還沒有安打。", "response": "這個打席他要把球看清楚。", "alt": ["還沒開張，這次先求有，不要求好。", "別急，等一顆自己要的球。", "一直沒安打，這打席不要亂追。", "沒安打也不用慌，球棒還是要放鬆。", "前面的打席不重要，這一棒才算數。", "手上沒東西，這時候最適合守住好球帶。", "他還在找感覺，先不要急著揮。", "零安打的人，下一棒常常就是爆發點。", "揮棒不要過大，把球碰到就有機會。", "別想著補回來，把眼前這一球打好。", "沒安打的壓力，其實比投手還大。"] },
      { "when": { "batterAb": { "min": 2 }, "batterHits": { "eq": 1 } }, "call": "這位打者今天已經有{n:batterHits}支安打進帳。" },
      { "when": { "batterHrToday": { "min": 1 } }, "call": "這位打者今天已經轟出{n:batterHrToday}發全壘打。", "response": "投手最好別投到中間。", "alt": ["他已經開過轟了，投手要小心。", "這種手感，一顆失投就飛出去了。"] },
      { "when": { "pitcherK": { "min": 3 } }, "call": "投手今天已經三振了{n:pitcherK}個人，現在面對下一位打者。" },
      { "when": { "tied": 0 }, "call": "{inning}局{half}，比數{n:awayScore}比{n:homeScore}，{outs}出局，{team}的打者上場。" },
      { "when": { "tied": 1 }, "call": "{inning}局{half}，{n:awayScore}比{n:homeScore}平手，{outs}出局，輪到{team}的打者。" }
    ] },
    "two_strikes": { "priority": 0, "silence": 0.6, "exchanges": [
      { "call": "兩好球。" },
      { "call": "追到兩好球了，投手掌握優勢。" },
      { "call": "兩好球了。", "response": "換我蹲，下一球我會往外角引誘。" }
    ] },
    "full_count": { "priority": 1, "silence": 0.3, "exchanges": [
      { "call": "滿球數！" },
      { "call": "兩好三壞，滿球數。", "response": "這種時候，蹲後面的人手心都是汗。" }
    ] },
    "stolen_base": { "priority": 1, "silence": 0.05, "exchanges": [
      { "call": "跑了！盜壘成功！", "response": "起跑太漂亮了，捕手傳再好也沒用。" },
      { "gag": "story", "sets": ["story"], "call": "跑了！安全上壘！", "response": "這球如果是我當年，一定抓得到。好啦，可能啦。" }
    ] },
    "caught_stealing": { "priority": 1, "silence": 0, "exchanges": [
      { "call": "跑了——觸殺出局！", "response": "球先到，手套就等在那邊，沒什麼好吵的。" },
      { "call": "盜壘，被抓到了！", "response": "這球傳得漂亮，我要幫捕手拍拍手。" },
      { "gag": "story", "needs": ["story"], "once": true, "call": "出局！周哥，這球你當年也抓得到吧？", "response": "我當年喔，瞪他一眼，他就自己回去了。" }
    ] },
    "run_scores": { "priority": 2, "silence": 0, "exchanges": [
      { "call": "{team}得分了！", "response": "這{n:runs}分很關鍵。現在比數{n:awayScore}比{n:homeScore}。" },
      { "call": "回來了！", "response": "壘上有人，就是要這樣打。" },
      { "when": { "tied": 1 }, "call": "追平了！", "response": "{n:awayScore}比{n:homeScore}，一切重來。" },
      { "when": { "runs": { "min": 2 } }, "call": "一口氣{n:runs}分！", "response": "一棒{n:runs}分，投手臉都綠了。" }
    ] },
    "home_run": { "priority": 2, "silence": 0, "exchanges": [
      { "gag": "earlyCall", "needs": ["earlyCall"], "once": true, "call": "打出去了——全壘打！", "response": "明凱，這次你沒喊錯，真的出去了。" },
      { "call": "球飛出去了，過了牆！", "response": "這球不用看，一出棒就知道了。" },
      { "call": "很遠喔——出牆了！", "response": "吃得太正了，沒有懸念。" },
      { "when": { "batterHrToday": { "min": 2 } }, "call": "又是他！全壘打！", "response": "今天第{n:batterHrToday}支了，投手今晚應該睡不著。" }
    ] },
    "strikeout": { "priority": 1, "silence": 0.2, "exchanges": [
      { "call": "三振！" },
      { "call": "揮空了，三振出局！", "response": "這一球投得很刁。", "alt": ["球從好球帶邊邊角角擦過去，打者很難受。", "這球的位置太刁了，看起來好球，其實揮不到。", "投手把球藏得很好，打者只能硬揮。", "最後這球變化很大，打者完全被騙到。"] },
      { "call": "三振！打者出局。", "response": "配球很聰明，前面幾球都是在鋪這一球。", "alt": ["前面都在布局，最後一球才收網。", "這個配球從第一球就開始算計了。", "前面讓他看慢的，最後來個快的，他來不及。", "捕手跟投手默契很好，這球是設計好的。"] },
      { "when": { "batterKToday": { "min": 3 } }, "call": "打者今天第{n:batterKToday}次三振。", "response": "帽子戲法了，今天真的不是他的日子。", "alt": ["三個三振收集齊了，今天他的棒子在休息。", "今天他一點都碰不到球，回去要好好檢討。", "這種日子，打者只想趕快結束。"] },
      { "when": { "batterKToday": 2 }, "call": "又被三振了，今天第二次。", "response": "兩次了，回休息區臉色應該不太好看。", "alt": ["兩個三振，這個打席要調整一下。", "連續被三振，下次要換個思路了。", "他回休息區大概會一直搖頭。"] },
      { "when": { "pitcherK": { "min": 6 } }, "call": "投手今天第{n:pitcherK}次三振！", "response": "今天他這顆球真的很犀利。", "alt": ["今天他的球威很夠，打者都很辛苦。", "他今天的控球和球速都在線上。", "這樣的投球內容，今天可以投很久。"] }
    ] },
    "walk": { "priority": 1, "silence": 0.4, "exchanges": [
      { "call": "四壞球，保送。" },
      { "call": "四壞球，保送上一壘。", "response": "很有耐心，壞球都沒有去追。" },
      { "when": { "runs": { "min": 1 } }, "call": "球太外了，保送！", "response": "擠回來的分數最傷了。" }
    ] },
    "intentional_walk": { "priority": 1, "silence": 0.2, "exchanges": [
      { "call": "故意保送，投手不跟他對決。", "response": "不跟他硬碰，賭下一棒。" }
    ] },
    "hit_by_pitch": { "priority": 1, "silence": 0.3, "exchanges": [
      { "gag": "story", "sets": ["story"], "call": "觸身球！", "response": "這顆很痛喔。我當年被打到，連叫都不敢叫。" },
